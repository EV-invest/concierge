# Copy to `.env` and adjust. Loaded by dotenvy in development.
# Topology (DATABASE_URL, CONCIERGE_BIND, REDIS_URL, AUTH_JWKS_GRPC_ENDPOINT)
# DEFAULTS from flake.nix (the `ports` attrset); anything set here or in the
# environment wins. Normally this file holds secrets. `nix run .#concierge`
# ensures the shared postgres + redis and points concierge at its `concierge` database.
# Max connections for the request-serving Postgres pool. Defaults to 10 when unset.
DB_MAX_CONNECTIONS=10
# The fund's genesis owners. Comma-separated; each entry is EITHER a canonical user id
# (a UUID) OR an e-mail address — an address can be filled in before that person has
# ever signed in, which is when their id first exists.
#
# It does two things, and both switch off for good once `users.role = 'owner'` is
# non-empty: the boot-time genesis seed writes these people into the owner registry (all
# of them at once, and only if at least two resolve), and until that lands a listed
# subject authorizes as an owner so the console is reachable. Empty ⇒ neither happens.
# After genesis the list is inert forever — the registry can never return to zero.
OWNER_SUBJECTS=

# Cross-plane bridge (identity → money). Shared bearer token the banking money plane
# presents on UserEvents.PullUserLifecycle (banking PULLS the user_outbox; concierge
# never calls banking). Must match BRIDGE_SERVICE_TOKEN on the banking side. Unset ⇒
# the bridge is not served (every pull is rejected). Graduate to mTLS/SPIFFE at scale.
BRIDGE_SERVICE_TOKEN=
RUST_LOG=info,concierge=debug,evconcierge_auth=debug

# ── Auth service (token issuance) ─────────────────────────────────────────────
# All optional: with no signing key the auth service runs inert (mints nothing) and
# the inbound verifier fails closed, so the plane still boots locally. To enable,
# generate an Ed25519 keypair:
#   openssl genpkey -algorithm ed25519 -out auth_ed25519.pem
# then set the PEM, a kid, and the matching public JWKS (a {"keys":[{OKP…}]} JSON).
AUTH_SIGNING_KEY_PEM=
AUTH_SIGNING_KID=
AUTH_JWKS_JSON=
# Issuer + audiences (defaults shown). Client access tokens carry the client aud;
# service tokens the service aud — distinct, so the two JWT directions stay apart.
# These MUST carry this plane's identity ("concierge"); a banking value is refused at
# boot (cross-plane footgun). (Refresh tokens are opaque rotated handles, not JWTs.)
AUTH_ISSUER=https://auth.concierge.ev
AUTH_CLIENT_AUDIENCE=concierge
AUTH_SERVICE_AUDIENCE=concierge-services
# Token TTLs in seconds (defaults: 15 min access, 30 d refresh, 5 min service).
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=2592000
AUTH_SERVICE_TTL_SECS=300
# Refresh-family lifetime bounds: absolute cap (default 90 d) and idle timeout (0 = off).
AUTH_MAX_SESSION_SECS=7776000
AUTH_IDLE_TIMEOUT_SECS=0

# Google OAuth2 confidential client (the BFF starts the redirect; the auth service
# does the code→token exchange). Empty ⇒ the Exchange route is disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry error tracking via ev::error_monitoring (optional — disabled when unset).
SENTRY_DSN=
APP_ENV=development

# PostHog product analytics via ev::analytics (optional — capture is a no-op when
# POSTHOG_KEY is unset). POSTHOG_HOST defaults to https://us.i.posthog.com.
POSTHOG_KEY=
POSTHOG_HOST=

# ── Notifications (email delivery) ────────────────────────────────────────────
# All optional: with no SMTP host the transport is a logging no-op, so the whole
# emit -> queue -> render path still runs locally and in CI, and only the final hop
# is suppressed. For Gmail use smtp.gmail.com:587 with an APP PASSWORD (the account
# needs 2FA); a plain account password will not authenticate.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=EV Investment <notifications@evinvest.ltd>
# Origin used to build links inside emails.
CABINET_URL=https://evinvest.ltd/cabinet
# Trailing-24h send ceiling. Gmail's relay caps daily volume and THROTTLES THE
# ACCOUNT past it, which would take every other transactional mail down with it, so
# the dispatcher stops sending (never queueing) at this number. Raise it in step with
# whatever provider is actually behind the transport port.
NOTIFICATION_DAILY_EMAIL_BUDGET=1500
NOTIFICATION_DISPATCH_INTERVAL_SECS=15
# Account-less subscribe attempts allowed per client IP per window. The durable
# per-address throttle and the daily budget above are what actually bound mail volume;
# this is just the cheap first gate.
SUBSCRIBE_RATE_LIMIT=5
SUBSCRIBE_RATE_WINDOW_SECS=3600

# ── Governance (the ownership consilium) ──────────────────────────────────────
# There is NO separate mail-relay secret. MailRelayService.SendGovernanceMail — the one
# seam banking PUSHES to — authenticates with the SAME BRIDGE_SERVICE_TOKEN above that
# banking already presents when it PULLS the user_outbox. One trust relationship between
# the two planes, one secret to rotate. Banking sends its `bridge_service_token` on both
# calls, so a second variable here would only ever be a way for the two to drift apart:
# every SendGovernanceMail would answer UNAUTHENTICATED, the mailer would retry and give
# up, and no owner would ever be emailed a payout approval.
#
# Base URL of the owner-removal approval page. The emailed token is appended as the final
# path segment, so a message carries `<this>/<token>` — keep it free of a trailing slash
# and of any query string.
#
# It is a CABINET route (`/{locale}/cabinet/owner-removal/{token}`) that is served
# PUBLICLY: the person opening it is the one being removed and may well not be signed in.
# It is not a `/governance/*` path — no such surface exists on the site.
#
# That page must send `Referrer-Policy: no-referrer`: the token travels in the URL, and a
# referrer leak hands it to every third party the page touches.
GOVERNANCE_APPROVAL_URL=https://evinvest.ltd/cabinet/owner-removal
